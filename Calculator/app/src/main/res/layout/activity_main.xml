<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    tools:context=".MainActivity">

    <androidx.cardview.widget.CardView
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#FFFFFF">

            <!-- Область вычислений (Экран) -->
            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#F8F9FA"
                android:padding="5dp"
                android:layout_marginBottom="24dp">

                <EditText
                    android:id="@+id/number1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:background="@android:color/transparent"
                    android:inputType="numberSigned|numberDecimal"
                    android:gravity="center"
                    android:hint="Число 1"
                    android:textColor="#212529"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/operation"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.6"
                    android:gravity="center"
                    android:textColor="#495057"
                    android:textStyle="bold"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/number2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:background="@android:color/transparent"
                    android:inputType="numberSigned|numberDecimal"
                    android:gravity="center"
                    android:hint="Число 2"
                    android:textColor="#212529"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/equal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.6"
                    android:gravity="center"
                    android:text="="
                    android:textColor="#495057"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/result"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.8"
                    android:gravity="center_vertical|start"
                    android:paddingStart="5dp"
                    android:textColor="#2B8A3E"
                    android:textStyle="bold"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- Сетка кнопок (GridLayout теперь на 4 колонки) -->
            <GridLayout
                android:id="@+id/gridLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:alignmentMode="alignBounds">

                <!-- Ряд 1 -->
                <Button
                    android:id="@+id/buttonAdd"
                    android:layout_width="65dp"
                    android:layout_height="60dp"
                    android:layout_margin="4dp"
                    android:text="+"
                    android:backgroundTint="#4C6EF5"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/buttonSubtract"
                    android:layout_width="65dp"
                    android:layout_height="60dp"
                    android:layout_margin="4dp"
                    android:text="-"
                    android:backgroundTint="#4C6EF5"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/buttonDivide"
                    android:layout_width="65dp"
                    android:layout_height="60dp"
                    android:layout_margin="4dp"
                    android:text="/"
                    android:backgroundTint="#4C6EF5"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/buttonMultiply"
                    android:layout_width="65dp"
                    android:layout_height="60dp"
                    android:layout_margin="4dp"
                    android:text="*"
                    android:backgroundTint="#4C6EF5"
                    android:textSize="22sp" />

                <!-- Ряд 2 (Дополнительные функции) -->
                <Button
                    android:id="@+id/buttonPower"
                    android:layout_width="65dp"
                    android:layout_height="60dp"
                    android:layout_margin="4dp"
                    android:text="^"
                    android:backgroundTint="#15AABF"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/buttonRemainder"
                    android:layout_width="65dp"
                    android:layout_height="60dp"
                    android:layout_margin="4dp"
                    android:text="%"
                    android:backgroundTint="#15AABF"
                    android:textSize="20sp" />

                <!-- Кнопка очистки на оставшиеся 2 ячейки -->
                <Button
                    android:id="@+id/buttonClean"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_margin="4dp"
                    android:text="Очистить"
                    android:backgroundTint="#FA5252"
                    android:textSize="16sp"
                    android:layout_columnSpan="2"
                    android:layout_gravity="fill_horizontal" />

            </GridLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>